# Iterative a_t, b_t plot in gnuplot

# Initial values
a0 = 0.5
b0 = 0.2

# Number of iterations
n = 100

# Output settings
set term pngcairo size 800,600 enhanced font 'Arial,12'
set output 'iteration_plot.png'

# Set up axes
set xlabel "Iteration t"
set ylabel "Value"
set title "Iteration of a_t and b_t"
set grid

# Prepare data file from iteration
set print $data
a = a0
b = b0
do for [t=0:n] {
    print t, a, b
    # Update b first
    b_new = ( (a + 1)**2 ) / ( 2*(a**2 + 1) )
    # Update a
    a_new = 2*b_new - 1
    # Assign new values
    a = a_new
    b = b_new
}
set print

# Plot from in-memory data
plot $data using 1:2 with linespoints title "a_t" lw 2 pt 7, \
     $data using 1:3 with linespoints title "b_t" lw 2 pt 5